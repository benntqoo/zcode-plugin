# 依赖
node_modules/
package-lock.json

# 本地工作区（agent 记忆 / 规划 / 会话笔记）—— 不进版本库
.workbuddy/

# 项目内 .zcode 运行时产物（memory-loop 候选收件箱等）—— 不入库；
# 但 .zcode/skills/ 是 skill-forge 的产出物（可复用方法论），放行
.zcode/*
!.zcode/skills/

# 临时草稿 / 一次性校验脚本
_*.mjs
_*.sh
_probe/
*.tmp
*.log

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Python 字节码缓存
__pycache__/

# 钩子运行时状态（若在仓库内被生成）
.hook-state/
